# Local development template. Keep the real .env private.
# Project dotenv overrides global JSON; process environment overrides dotenv.
# Supported command arguments have highest precedence.

GatewayBaseAddress=http://localhost:4000
EnableTelemetry=false

# Legacy standalone host provider array; do not combine with saved-provider dictionary paths.
Providers__0__ProviderType=Azure
Providers__0__BaseAddress=https://your-resource-name.openai.azure.com
Providers__0__ApiKey=replace-with-real-api-key
Providers__0__DeploymentName=gpt-4.1
Providers__0__Models__0=gpt-4.1

# Route model aliases
RouteModel__DefaultModel=azure/gpt-4.1
RouteModel__ThinkingModel=azure/gpt-4.1
RouteModel__SearchModel=azure/gpt-4.1

# Live-test provider sections; enable only after supplying private credentials and models.
Anthropic__Enabled=false
Anthropic__Endpoint=https://api.anthropic.com
Anthropic__ApiKey=
Anthropic__Model=

OpenAI__Enabled=false
OpenAI__Endpoint=
OpenAI__ApiKey=
OpenAI__Model=

LiveTests__DeadlineSeconds=60
LiveTests__MaxOutputTokens=128

# Set AR_LIVE_TESTS=1 only in the process environment to consent to paid tests.
# AR_CONFIG_DIR and AR_SECRET_KEY are process-level bootstrap controls, not JSON paths.